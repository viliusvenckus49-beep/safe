# Replace with BotFather token; never commit .env.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_IDS=123456789
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./safecheck.db
LOG_LEVEL=INFO
REP_COOLDOWN_SECONDS=60
REPORT_COOLDOWN_SECONDS=300
FSM_TTL_SECONDS=1800
# For Compose set ENVIRONMENT=production and the following values:
# DATABASE_URL=postgresql+asyncpg://safecheck:YOUR_URL_ENCODED_PASSWORD@postgres:5432/safecheck
# REDIS_URL=redis://redis:6379/0
# POSTGRES_PASSWORD=YOUR_GENERATED_PASSWORD

# Optional outbound proxy; otherwise HTTPS_PROXY / HTTP_PROXY is inherited.
# TELEGRAM_PROXY_URL=http://proxy-host:8080

# Only this configured administrator may approve/manage groups.
# Required when ADMIN_IDS contains multiple administrators.
# GROUP_OWNER_ID=123456789
