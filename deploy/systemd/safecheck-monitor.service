[Unit]
Description=SAFECheck health and outbox monitor
Requires=docker.service
After=docker.service
ConditionPathExists=/etc/safecheck/compose.env

[Service]
Type=oneshot
WorkingDirectory=/opt/safecheck-monitor
Environment=SAFECHECK_OPS_OPTIONS=
EnvironmentFile=-/etc/safecheck/operations.env
ExecStart=/usr/bin/python3 /opt/safecheck-monitor/monitor_runtime.py $SAFECHECK_OPS_OPTIONS
TimeoutStartSec=3min
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/safecheck /var/backups/safecheck
